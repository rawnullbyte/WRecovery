# WRecovery kernel config fragment
#
# This is applied on top of `make allnoconfig`, i.e. the starting point is an
# empty configuration and every option below is deliberately switched on.
# Keep it that way: adding to a defconfig-derived config silently drags in
# megabytes of drivers (i915 alone is 2.2 MB).
#
# Everything is built in (=y). CONFIG_MODULES is off, so no module tree is
# built and the ISO cannot miss a driver because of a forgotten module.
#
# Sizes are for the XZ-compressed bzImage; the whole ISO budget is 10 MiB.

# --- basic kernel plumbing -------------------------------------------------
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_HW_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_ELF_CORE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_PRINTK_TIME=n
CONFIG_UEVENT_HELPER=n
CONFIG_FW_LOADER=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_PM=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_KERNEL=n
CONFIG_PERF_EVENTS=n
CONFIG_PROFILING=n
CONFIG_FTRACE=n
CONFIG_BPF_SYSCALL=n
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_AUDIT=n
CONFIG_SECURITY=n
CONFIG_MODULES=n
CONFIG_MODULE_SIG=n
CONFIG_IKCONFIG=n
CONFIG_IKHEADERS=n
CONFIG_SWAP=n
CONFIG_ZSWAP=n
CONFIG_COREDUMP=n
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_AIO=n
CONFIG_IO_URING=n
CONFIG_FANOTIFY=n
CONFIG_INOTIFY_USER=n
CONFIG_QUOTA=n
CONFIG_KEYS=n
CONFIG_SYSVIPC=n
CONFIG_POSIX_MQUEUE=n
CONFIG_USERFAULTFD=n
CONFIG_MEMCG=n
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_STACKTRACE=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_HARDENED_USERCOPY=n
CONFIG_GCC_PLUGINS=n
CONFIG_KASAN=n
CONFIG_KCSAN=n
CONFIG_UBSAN=n
CONFIG_KCOV=n

# --- CPU / platform --------------------------------------------------------
CONFIG_SMP=n
CONFIG_X86_MCE=n
CONFIG_X86_CPUID=n
CONFIG_MICROCODE=n
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_X86_MSR=y
CONFIG_HPET_TIMER=y
CONFIG_ACPI=y
CONFIG_ACPI_TABLES=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y
CONFIG_HOTPLUG_PCI=n
CONFIG_PNP=n
CONFIG_ISA=n
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200n8 loglevel=4"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y
CONFIG_KERNEL_GZIP=n
CONFIG_DEBUG_INFO_NONE=y

# --- console: BIOS text mode + UEFI framebuffer + serial -------------------
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4

# --- block layer + partitioning -------------------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_ADVANCED=n
CONFIG_BLK_DEV_LOOP=n
CONFIG_BLK_DEV_RAM=n

# --- storage controllers ---------------------------------------------------
CONFIG_ATA=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_PATA_AMD=y
CONFIG_PATA_ATIIXP=y
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_SCH=y
CONFIG_PATA_SIS=y
CONFIG_PATA_VIA=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y

# --- USB (sticks, keyboards, hubs) ----------------------------------------
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# --- input -----------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y

# --- filesystems: the whole point -----------------------------------------
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
