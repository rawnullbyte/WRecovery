#!/bin/sh
# wmount - find and mount Windows-style volumes
#
# usage: wmount                mount every volume read-only (default)
#        wmount -w             mount every volume read-write (dangerous)
#        wmount -w sdb1        mount one volume read-write (safe)
#        wmount -u             unmount everything WRecovery mounted
#        wmount -l             just list what is there

. /lib/wrecovery.sh

rw=ro
only=""
while [ $# -gt 0 ]; do
	case $1 in
	-w|--rw) rw=rw ;;
	-u|--umount) unmount_all; exit 0 ;;
	-l|--list) wdisks; exit 0 ;;
	-h|--help) sed -n '2,9p' "$0"; exit 0 ;;
	-*) die "unknown option: $1" ;;
	*) only="$only $1" ;;
	esac
	shift
done

[ -f "$MOUNT_DB" ] || db_reset

if [ -n "$only" ]; then
	for n in $only; do
		case $n in
		/dev/*) dev=$n; n=${n##*/} ;;
		*) dev=/dev/${n#/dev/} ;;
		esac
		[ -b "$dev" ] || die "$dev is not a block device"
		mount_part "$n" "$dev" "$rw" || warn "$n: could not mount (see wdisks)"
	done
else
	mount_all "$rw"
fi

wdisks
if [ "$rw" = rw ]; then
	warn "read-write mount: changes are possible, do not do this on evidence"
fi