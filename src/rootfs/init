#!/bin/sh
# /init - PID 1 for the WRecovery live environment
#
# Brings up the pseudo filesystems, mounts every Windows volume read-only,
# runs the network recovery pass and then hands out shells on tty1..3 plus
# the first serial port.

PATH=/bin:/sbin
export PATH
umask 022

mkdir -p /proc /sys /dev /tmp /run /mnt /root /etc
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /run/reports /run/state /var/log

echo 4 >/proc/sys/kernel/printk 2>/dev/null

. /lib/wrecovery.sh

spawn_shell() {
	[ -c "/dev/$1" ] || return 0
	(
		while :; do
			setsid sh -c "exec sh -l </dev/$1 >/dev/$1 2>&1"
			sleep 1
		done
	) &
}

# ---------------------------------------------------------------- boot work --

db_reset
wrecovery_boot >/dev/console 2>&1

# tty1 runs the menu; choosing "Shell" there replaces it with a login shell
# and exiting that shell brings the menu back.
spawn_menu() {
	[ -c /dev/tty1 ] || return 0
	(
		while :; do
			setsid sh -c "exec /bin/wretui </dev/tty1 >/dev/tty1 2>&1"
			sleep 1
		done
	) &
}

spawn_menu
spawn_shell tty2
spawn_shell tty3
spawn_shell ttyS0

# PID 1 must never exit: reap children forever
while :; do
	wait
done